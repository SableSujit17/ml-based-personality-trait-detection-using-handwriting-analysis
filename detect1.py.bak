import tkinter as tk
from tkinter import *
from tkinter import filedialog, messagebox
from tkinter import ttk
from PIL import Image, ImageTk
from classify import predict_personality

# ---------------- Root Window ----------------
root = tk.Tk()
root.title("AI Handwriting Analysis - Dashboard")
root.geometry("1200x700")
root.resizable(False, False)

# ---------------- Colors ----------------
bg_main = "#0f1c2e"
sidebar_color = "#1f2a3a"
card_color = "#1c2b40"
button_blue = "#3b82f6"
button_green = "#22c55e"
button_orange = "#f59e0b"
button_red = "#ef4444"

root.configure(bg=bg_main)

# ---------------- Global Variables ----------------
selected_img_path = None
uploaded_image = None

# ---------------- Sidebar ----------------
sidebar = Frame(root, bg=sidebar_color, width=220)
sidebar.pack(side="left", fill="y")

Label(sidebar, text="AI Handwriting",
      bg=sidebar_color, fg="white",
      font=("Arial", 16, "bold")).pack(pady=20)

Button(sidebar, text="Logout",
       bg=button_red, fg="white",
       width=18, relief="flat",
       command=root.destroy).pack(side="bottom", pady=20)

# ---------------- Header ----------------
Label(root, text="Welcome, User",
      bg=bg_main, fg="white",
      font=("Arial", 20, "bold")).place(x=250, y=20)

# ---------------- Upload Section ----------------
upload_frame = Frame(root, bg=card_color, width=400, height=400)
upload_frame.place(x=300, y=120)

Label(upload_frame, text="Upload Handwriting",
      bg=card_color, fg="white",
      font=("Arial", 14, "bold")).pack(pady=15)

preview_label = Label(upload_frame, bg=card_color)
preview_label.pack(pady=10)


def open_file():
    global selected_img_path, uploaded_image

    filename = filedialog.askopenfilename(
        filetypes=[("Image Files", "*.jpg *.png *.jpeg")]
    )

    if filename:
        selected_img_path = filename

        img = Image.open(filename)
        img = img.resize((250, 180))
        uploaded_image = ImageTk.PhotoImage(img)
        preview_label.config(image=uploaded_image)


Button(upload_frame,
       text="Choose Image",
       bg=button_blue,
       fg="white",
       width=20,
       command=open_file).pack(pady=5)

# ---------------- Analysis Section ----------------
analysis_frame = Frame(root, bg=card_color, width=400, height=400)
analysis_frame.place(x=750, y=120)

Label(analysis_frame,
      text="AI Personality Analysis",
      bg=card_color,
      fg="white",
      font=("Arial", 14, "bold")).pack(pady=15)

progress_bar = ttk.Progressbar(
    analysis_frame,
    orient="horizontal",
    length=300,
    mode="determinate"
)
progress_bar.pack(pady=20)

percentage_label = Label(analysis_frame,
                         text="0%",
                         bg=card_color,
                         fg="#22c55e",
                         font=("Arial", 16, "bold"))
percentage_label.pack()

Label(analysis_frame,
      text="Detected Trait:",
      bg=card_color,
      fg="white",
      font=("Arial", 12)).pack(pady=(20, 0))

detected_trait_label = Label(analysis_frame,
                             text="--",
                             bg=card_color,
                             fg="#3b82f6",
                             font=("Arial", 12, "bold"))
detected_trait_label.pack()

Label(analysis_frame,
      text="Accuracy:",
      bg=card_color,
      fg="white",
      font=("Arial", 12)).pack(pady=(15, 0))

accuracy_label = Label(analysis_frame,
                       text="--",
                       bg=card_color,
                       fg="#22c55e",
                       font=("Arial", 12, "bold"))
accuracy_label.pack()


def analyze_image():
    global selected_img_path

    if not selected_img_path:
        messagebox.showerror("Error", "Please select an image first!")
        return

    label, confidence = predict_personality(selected_img_path)

    detected_trait_label.config(text=label)
    accuracy_label.config(text=f"{confidence:.2f}%")
    percentage_label.config(text=f"{confidence:.0f}%")
    progress_bar["value"] = confidence


Button(analysis_frame,
       text="Analyze Now",
       bg=button_green,
       fg="white",
       width=20,
       command=analyze_image).pack(pady=20)

# ---------------- Footer ----------------
Label(root,
      text="Final Year BE IT Project | AI-Based Handwriting Analysis System | 2026",
      bg=bg_main,
      fg="gray",
      font=("Arial", 9)).place(x=350, y=650)

root.mainloop()
